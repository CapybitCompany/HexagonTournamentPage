---
const {
    src,
    headerText,
    href,
    comingSoon = false,
    soonText = "Niebawem",
    progress,
    eta,
    available = true,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const progressNum = typeof progress === "number" ? Math.max(0, Math.min(100, progress)) : null;
const hasFooter = progressNum !== null || !!eta;
const isLinked = !!href && available;
const Tag: any = isLinked ? "a" : "div";
const linkProps = isLinked ? { href } : { "aria-disabled": "true" };
---
<div class={`discordContainerWrapper ${!available ? "isLocked" : ""}`}>
    <Tag {...linkProps} class={`hexCard ${!isLinked ? "disabledLink" : ""}`}>
        <div class="discordContainer">
            <div class="imageContainer">
                {src ? (
                    <img class="hexImage" src={`${base}${src}`} alt={headerText} loading="lazy" decoding="async"/>
                ) : (
                    <div class="hexPlaceholder" style={`background-image: url('${base}images/stonebrick.jpg');`} aria-hidden="true"></div>
                )}
                <div class="hexImageOverlay" aria-hidden="true"></div>
                {!available && (
                    <span class="hexLockBadge" aria-hidden="true">
                        <span class="hexLockBadgeIcon">🔒</span>
                        <span class="hexLockBadgeText">{soonText}</span>
                    </span>
                )}
            </div>

            {hasFooter && (
                <div class="hexFooter">
                    {progressNum !== null && (
                        <div class="hexProgress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={progressNum} aria-label={`Postęp prac: ${progressNum}%`}>
                            <div class="hexProgressBar" style={`width: ${progressNum}%;`}></div>
                            <span class="hexProgressLabel">{progressNum}%</span>
                        </div>
                    )}
                    {eta && <span class="hexEta">ETA: {eta}</span>}
                </div>
            )}
        </div>
    </Tag>
</div>

<style>
    .discordContainerWrapper {
        width: 100%;
        justify-content: center;
        margin: 10px 15px;
        display: flex;
    }

    .hexCard {
        display: block;
        width: 100%;
        color: inherit;
        text-decoration: none;
    }

    .disabledLink {
        cursor: default;
        text-decoration: none;
    }

    .discordContainer {
        width: 100%;
        max-width: 100%;
        display: flex;
        flex-direction: column;
        color: white;
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
        box-sizing: border-box;
    }

    /* ===== IMAGE AREA ===== */
    .imageContainer {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #0a0d12;
    }

    .hexImage,
    .imageContainer img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transform-origin: center;
        transform: scale(1);
        transition: transform 0.55s ease, filter 0.35s ease;
    }

    .hexPlaceholder {
        position: absolute;
        inset: 0;
        background-repeat: repeat;
        background-size: 128px 128px;
        image-rendering: pixelated;
    }

    /* Locked tiles keep more of the original artwork visible. */
    .isLocked .hexImage,
    .isLocked .imageContainer img {
        object-fit: contain;
        box-sizing: border-box;
        padding: 14px 18px 10px;
        transform: scale(1.02);
        filter: brightness(0.55) saturate(0.78) contrast(0.95);
    }

    .isLocked .hexPlaceholder {
        filter: brightness(0.55) saturate(0.78) contrast(0.95);
    }

    /* Permanent gradient overlay for legibility of the title */
    .hexImageOverlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg,
            rgba(10, 13, 18, 0.05) 0%,
            rgba(10, 13, 18, 0.35) 55%,
            rgba(10, 13, 18, 0.88) 100%);
        pointer-events: none;
        z-index: 1;
    }

    /* Locked tiles get a stronger overlay tint */
    .isLocked .hexImageOverlay {
        background: linear-gradient(180deg,
            rgba(10, 13, 18, 0.25) 0%,
            rgba(10, 13, 18, 0.55) 55%,
            rgba(10, 13, 18, 0.92) 100%);
    }

    /* ===== LOCK BADGE ===== */
    .hexLockBadge {
        position: absolute;
        right: 10px;
        bottom: 10px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        background: rgba(10, 13, 18, 0.78);
        border: 1px solid rgba(255, 207, 90, 0.35);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        color: #ffd88c;
        font-family: "Montserrat", system-ui, sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        line-height: 1;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
    }

    .hexLockBadgeIcon {
        font-size: 0.85rem;
        line-height: 1;
    }

    /* ===== FOOTER (progress + ETA) ===== */
    .hexFooter {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 12px 14px 14px;
        background: linear-gradient(180deg, rgba(10, 13, 18, 0.85), rgba(10, 13, 18, 0.95));
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .hexProgress {
        position: relative;
        width: 100%;
        height: 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 207, 90, 0.22);
        overflow: hidden;
    }

    .hexProgressBar {
        height: 100%;
        background: linear-gradient(90deg, rgba(255, 166, 0, 0.85), rgba(255, 207, 90, 0.95));
        box-shadow: 0 0 10px rgba(255, 166, 0, 0.4);
        transition: width 0.6s ease;
    }

    .hexProgressLabel {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Montserrat", system-ui, sans-serif;
        font-size: 0.66rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.06em;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
    }

    .hexEta {
        font-family: "Montserrat", system-ui, sans-serif;
        text-align: center;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 207, 90, 0.9);
    }

    /* ===== HOVER ===== */
    @media (hover: hover) {
        .discordContainerWrapper:not(.isLocked) .hexCard:hover .discordContainer {
            border-color: rgba(255, 166, 0, 0.4);
            box-shadow:
                0 0 24px rgba(255, 166, 0, 0.15),
                0 14px 36px rgba(0, 0, 0, 0.45);
            transform: translateY(-4px);
        }

        .discordContainerWrapper:not(.isLocked) .hexCard:hover .hexImage,
        .discordContainerWrapper:not(.isLocked) .hexCard:hover .imageContainer img {
            transform: scale(1.08);
        }

        .isLocked .hexCard:hover .discordContainer {
            border-color: rgba(255, 255, 255, 0.14);
            transform: translateY(-2px);
        }

        .isLocked .hexCard:hover .hexImage,
        .isLocked .hexCard:hover .imageContainer img {
            transform: scale(1.05);
            filter: brightness(0.7) saturate(0.85) contrast(0.95);
        }
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 980px) {
        .discordContainerWrapper {
            margin: 10px 0;
        }
    }

    @media (max-width: 600px) {
        .imageContainer {
            aspect-ratio: 16 / 10;
        }
        .hexFooter {
            padding: 10px 12px 12px;
        }
        .hexProgress {
            height: 14px;
        }
        .hexLockBadge {
            font-size: 0.62rem;
            padding: 4px 8px;
        }
    }
</style>
