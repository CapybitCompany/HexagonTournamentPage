            { icon: '🎲', title: 'Random Teleport', text: 'Każdy gracz startuje w innym miejscu — żadnych klastrów baz.' },
            { icon: '📜', title: 'Tutorial-quest', text: 'Postaw pierwszego miniona, zbierz 32 cobblestone, dostajesz ulepszenie.' },
            { icon: '🎁', title: 'Event startowy', text: 'Pierwsi gracze dostają złoty kilof + słup surowców do wykopania.' },
        ],
        bullets: [
            'Daily quest + nagrody za codzienne logowanie (retention)',
