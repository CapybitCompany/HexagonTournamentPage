    },
    {
        id: 'bossy',
        label: 'Bossy & PvE',
        icon: '🐉',
        tagline: 'ENDGAME',
        title: 'Mob → Miniboss → Boss → Dungeon',
        intro: 'Świat podzielony na biomy easy → mid → hard. 3–4 globalne custom moby + unikalne biomy z własnymi przeciwnikami i dropami. Endgame to bossy z unikalnymi mechanikami, preferowane party.',
        features: [
            { icon: '👹', title: 'Custom moby', text: '3–4 globalne moby + unikalne dla 3–4 biomów/struktur.' },
            { icon: '👑', title: 'Minibossy na wilderness', text: 'Spawn z info ±200 kratek. Boss ma „tag" — kto zada najwięcej DMG, dostaje loot.' },
            { icon: '🎟️', title: 'Wejściówki do bossów', text: 'Drop z trudniejszych mobów lub crafting z kolekcji.' },
            { icon: '🏰', title: 'Dungeony', text: 'W iteracjach po starcie — kolejne poziomy trudności i loot.' },
        ],
        bullets: [
            'Custom broń działa TYLKO w PvE (balans PvP zachowany)',
            'Endgame boss preferuje COOP / party',
            'Najlepszy gear: kolekcje + drop z bossów + crafting z rzadkich materiałów',
        ],
        media: {
            type: 'placeholder',
            caption: 'Walka z bossem — wkrótce',
        },
        badges: ['3 tiery biomów', 'PvE only', 'Party content'],
    },
    {
        id: 'ekonomia',
        label: 'Ekonomia',
        icon: '💰',
        tagline: 'PLAYER-DRIVEN',
        title: 'Auction House > NPC',
        intro: 'Pieniądze zdobywasz powoli, wydajesz dużo. Główny obrót generuje handel między graczami przez Auction House. NPC sprzedaje QoL po wysokich cenach — to opcja awaryjna, nie główne źródło.',
