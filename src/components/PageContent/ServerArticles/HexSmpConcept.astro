            caption: 'Spawn point + NPC — wkrótce',
        },
        badges: ['MVP-friendly', 'RTP start', 'Event na otwarcie'],
    },
];
---

<section class="smpConcept reveal" id="smpConcept" aria-labelledby="smpConceptTitle">
    <div class="smpConceptHeader">
        <span class="smpConceptLabel">// HEX SMP — KONCEPCJA</span>
        <h2 id="smpConceptTitle" class="smpConceptTitle">Czym dokładnie będzie HEX SMP?</h2>
        <p class="smpConceptSub">
            Inspirowane Hypixel Skyblock, ale w naszych zasadach — <strong>bez skybloków</strong>, za to z <strong>miastami</strong>, które naprawdę żyją. Wybierz zakładkę i zobacz co Cię czeka.
        </p>
    </div>

    <div class="smpConceptShell" data-tabs-root>
        <!-- TABS NAV -->
        <div class="smpConceptTabs" role="tablist" aria-label="Mechaniki HEX SMP">
            {tabs.map((tab, i) => (
                <button
                    type="button"
                    role="tab"
                    class={`smpConceptTab${i === 0 ? ' is-active' : ''}`}
                    id={`smpTab-${tab.id}`}
                    data-tab-target={tab.id}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    aria-controls={`smpPanel-${tab.id}`}
                    tabindex={i === 0 ? 0 : -1}
                >
                    <span class="smpConceptTabIcon" aria-hidden="true">{tab.icon}</span>
                    <span class="smpConceptTabLabel">{tab.label}</span>
                    <span class="smpConceptTabIndex" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                </button>
            ))}
            <div class="smpConceptTabIndicator" data-tab-indicator></div>
        </div>

        <!-- PANELS -->
        <div class="smpConceptPanels">
            {tabs.map((tab, i) => (
                <article
                    role="tabpanel"
                    class={`smpConceptPanel${i === 0 ? ' is-active' : ''}`}
                    id={`smpPanel-${tab.id}`}
                    aria-labelledby={`smpTab-${tab.id}`}
                    data-tab-panel={tab.id}
                    hidden={i !== 0}
                >
                    <div class="smpConceptPanelGrid">
                        <div class="smpConceptPanelText">
                            <span class="smpConceptTagline">{tab.tagline}</span>
                            <h3 class="smpConceptPanelTitle">
                                <span class="smpConceptPanelEmoji" aria-hidden="true">{tab.icon}</span>
                                {tab.title}
                            </h3>
                            <p class="smpConceptIntro">{tab.intro}</p>

                            {tab.badges && (
                                <div class="smpConceptBadges">
                                    {tab.badges.map((b) => <span class="smpConceptBadge">{b}</span>)}
                                </div>
                            )}

                            <div class="smpConceptFeatures">
                                {tab.features.map((f, fi) => (
                                    <div class="smpConceptFeature" style={`--fi:${fi}`}>
                                        <span class="smpConceptFeatureIcon" aria-hidden="true">{f.icon}</span>
                                        <div class="smpConceptFeatureBody">
                                            <h4>{f.title}</h4>
                                            <p>{f.text}</p>
                                        </div>
                                    </div>
                                ))}
                            </div>

                            {tab.bullets && tab.bullets.length > 0 && (
                                <ul class="smpConceptBullets">
                                    {tab.bullets.map((b) => <li>{b}</li>)}
                                </ul>
                            )}
                        </div>

                        <div class="smpConceptMedia">
                            <div class="smpConceptMediaFrame">
                                {tab.media.type === 'placeholder' && (
                                    <div class="smpConceptMediaPlaceholder">
                                        <span class="smpConceptMediaPlay" aria-hidden="true">▶</span>
                                        <span class="smpConceptMediaCaption">{tab.media.caption}</span>
                                    </div>
                                )}
                                {tab.media.type === 'image' && tab.media.src && (
                                    <picture>
                                        <img src={`${base}${tab.media.src}`} alt={tab.media.alt ?? tab.media.caption} loading="lazy" decoding="async" />
                                    </picture>
                                )}
                                {tab.media.type === 'video' && tab.media.src && (
                                    <video
                                        src={`${base}${tab.media.src}`}
                                        poster={tab.media.poster ? `${base}${tab.media.poster}` : undefined}
                                        controls
                                        preload="none"
                                        playsinline
                                    ></video>
                                )}
                            </div>
                            <span class="smpConceptMediaNote">📸 Miejsce na screen / film z gameplay</span>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<script>
    type TabRoot = HTMLElement;

    function initTabs(root: TabRoot) {
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab-target]'));
        const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-tab-panel]'));
        const indicator = root.querySelector<HTMLElement>('[data-tab-indicator]');

        function moveIndicator(target: HTMLButtonElement) {
            if (!indicator) return;
            const rectRoot = (target.parentElement as HTMLElement).getBoundingClientRect();
            const rect = target.getBoundingClientRect();
            // Decide orientation: if tabs are stacked vertically (desktop), use top/height; else left/width
            const isVertical = window.matchMedia('(min-width: 900px)').matches;
            if (isVertical) {
                indicator.style.transform = `translateY(${rect.top - rectRoot.top}px)`;
                indicator.style.height = `${rect.height}px`;
                indicator.style.width = '';
                indicator.style.left = '';
            } else {
                indicator.style.transform = `translateX(${rect.left - rectRoot.left}px)`;
                indicator.style.width = `${rect.width}px`;
                indicator.style.height = '';
                indicator.style.top = '';
            }
        }

        function activate(id: string, focusTab = false) {
            tabs.forEach((t) => {
                const active = t.dataset.tabTarget === id;
                t.classList.toggle('is-active', active);
                t.setAttribute('aria-selected', active ? 'true' : 'false');
                t.tabIndex = active ? 0 : -1;
                if (active) {
                    moveIndicator(t);
                    if (focusTab) t.focus();
                }
            });
            panels.forEach((p) => {
                const active = p.dataset.tabPanel === id;
                p.classList.toggle('is-active', active);
                if (active) {
                    p.removeAttribute('hidden');
                } else {
                    p.setAttribute('hidden', '');
                }
            });
        }

        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => {
                const id = tab.dataset.tabTarget;
                if (id) activate(id);
            });
            tab.addEventListener('keydown', (e) => {
                let nextIndex = -1;
                if (e.key === 'ArrowDown' || e.key === 'ArrowRight') nextIndex = (i + 1) % tabs.length;
                else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') nextIndex = (i - 1 + tabs.length) % tabs.length;
                else if (e.key === 'Home') nextIndex = 0;
                else if (e.key === 'End') nextIndex = tabs.length - 1;
                if (nextIndex >= 0) {
                    e.preventDefault();
                    const id = tabs[nextIndex].dataset.tabTarget;
                    if (id) activate(id, true);
                }
            });
        });

        // Initial indicator placement
        const activeTab = tabs.find((t) => t.classList.contains('is-active')) ?? tabs[0];
        if (activeTab) requestAnimationFrame(() => moveIndicator(activeTab));

        // Reposition on resize
        let resizeTimer: number | undefined;
        window.addEventListener('resize', () => {
            if (resizeTimer) window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(() => {
                const current = tabs.find((t) => t.classList.contains('is-active'));
                if (current) moveIndicator(current);
            }, 80);
        });
    }

    document.querySelectorAll<HTMLElement>('[data-tabs-root]').forEach(initTabs);
</script>

<style>
    .smpConcept {
        width: 100%;
        margin: 0 auto;
        padding: 24px 0 8px 0;
        color: #e0d8cc;
    }

    .smpConceptHeader {
        text-align: center;
        margin-bottom: 32px;
        padding: 0 16px;
    }

    .smpConceptLabel {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(100, 180, 255, 0.85);
        background: rgba(100, 180, 255, 0.08);
        border: 1px solid rgba(100, 180, 255, 0.2);
        border-radius: 999px;
        padding: 4px 14px;
        margin-bottom: 12px;
    }

    .smpConceptTitle {
        font-size: clamp(1.5rem, 3.2vw, 2.2rem);
        margin: 0 0 10px 0;
        color: #fff;
        line-height: 1.2;
    }

    .smpConceptSub {
        max-width: 640px;
        margin: 0 auto;
        color: rgba(255, 255, 255, 0.72);
        font-size: 1rem;
        line-height: 1.6;
    }

    /* ===== SHELL ===== */
    .smpConceptShell {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 20px;
        background: linear-gradient(180deg, rgba(20, 26, 36, 0.85) 0%, rgba(12, 16, 22, 0.85) 100%);
        border: 1px solid rgba(100, 180, 255, 0.14);
        border-radius: 16px;
        padding: 16px;
        box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.03);
        position: relative;
        overflow: hidden;
    }

    .smpConceptShell::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(100, 180, 255, 0.05) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
        opacity: 0.5;
    }

    /* ===== TABS NAV (vertical on desktop) ===== */
    .smpConceptTabs {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 6px;
        background: rgba(8, 11, 16, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
        z-index: 1;
    }

    .smpConceptTab {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        text-align: left;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 10px;
        color: rgba(224, 216, 204, 0.7);
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 12px 14px;
        cursor: pointer;
        transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
        z-index: 2;
    }

    .smpConceptTab:hover {
        color: #fff;
        background: rgba(255, 207, 90, 0.06);
    }

    .smpConceptTab.is-active {
        color: #fff;
        background: rgba(255, 207, 90, 0.1);
    }

    .smpConceptTab:focus-visible {
        outline: 2px solid #ffcf5a;
        outline-offset: 2px;
    }

    .smpConceptTabIcon {
        font-size: 1.25rem;
        line-height: 1;
        filter: drop-shadow(0 2px 6px rgba(255, 207, 90, 0.25));
    }

    .smpConceptTabLabel { flex: 1; }

    .smpConceptTabIndex {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.3);
        font-variant-numeric: tabular-nums;
    }

    .smpConceptTab.is-active .smpConceptTabIndex { color: rgba(255, 207, 90, 0.7); }

    .smpConceptTabIndicator {
        position: absolute;
