---
// Interaktywny komponent z zakładkami prezentujący mechaniki HEX SMP
// Inspirowane Hypixel Skyblock, ale w wersji "miasta gracza" (nie skybloki).
const base = import.meta.env.BASE_URL;

type TabFeature = { icon: string; title: string; text: string };
type Tab = {
    id: string;
    label: string;
    icon: string;
    tagline: string;
    title: string;
    intro: string;
    features: TabFeature[];
    bullets?: string[];
    media: {
        type: 'image' | 'video' | 'placeholder';
        src?: string;
        poster?: string;
        alt?: string;
        caption: string;
    };
    badges?: string[];
};

const tabs: Tab[] = [
    {
        id: 'miasta',
        label: 'Miasta',
        icon: '🏛️',
        tagline: 'CORE GAMEPLAY',
        title: 'Miasto = Twoja baza, Twoja fabryka',
        intro: 'Stawiasz blok „Serce bazy" i automatycznie claimujesz teren. Zarządzasz panelem, członkami COOP i limitami minionów. Miasto to SafeZone — bez PvP, bez griefów, ale z pełnym ryzykiem PvE.',
        features: [
            { icon: '🛡️', title: 'SafeZone', text: 'Brak PvP i niszczenia bloków przez graczy. Twoje zasoby są bezpieczne.' },
            { icon: '🧱', title: 'Serce bazy', text: 'Custom blok-entity z HP i regenem. To on definiuje granice Twojego miasta.' },
            { icon: '📈', title: 'Rozwój', text: 'Powiększaj cuboid, kupuj kolejne chunki, zwiększaj limity minionów.' },
            { icon: '👑', title: 'Twoje reguły', text: 'Panel zarządzania pozwala kontrolować członków, prawa i limity.' },
        ],
        media: {
            type: 'placeholder',
            caption: 'Render miasta gracza — wkrótce',
        },
        badges: ['SafeZone PvE', 'Cuboid + Panel', 'Auto-claim'],
    },
    {
        id: 'miniony',
        label: 'Miniony',
        icon: '⛏️',
        tagline: 'OFFLINE PROGRESS',
        title: 'Pracują nawet gdy śpisz',
        intro: 'Trzy typy startowe: mining, farming, combat. 6 slotów na start, do 10 poziomów ulepszeń każdy. Wolniejsze niż aktywna gra — ale działają 24/7. Główny powód, dla którego wracasz na serwer.',
        features: [
            { icon: '⚡', title: 'Paliwo (fuel)', text: 'Drogie i zużywalne, ale znacząco przyspiesza działanie miniona.' },
            { icon: '🔥', title: 'Auto-smelting', text: 'Surowce przetwarzane są automatycznie w trakcie zbierania.' },
            { icon: '✨', title: 'Auto-crafting', text: 'Tworzenie enchantowanych wersji surowców do mid/endgame.' },
